---
import { t, type Lang } from "../lib/i18n";
import DownloadCards from "./DownloadCards";
import { LATEST, RELEASES } from "../site-meta";

const { lang, standalone = false } = Astro.props;
const _ = (key: string) => t(lang, key);
const Heading = standalone ? "h1" : "h2";
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const route = (p: string) => `${base}${lang === "en" ? "/en" : ""}${p === "/" ? "/" : p}`;
---

<section id="download" class="shell content-section download-section">
  <div class="section-heading"><Heading>{_("下载 Crossbow")}</Heading></div>
  <DownloadCards client:load lang={lang} />
  <div class="download-links">
    <a href={RELEASES} target="_blank" rel="noopener noreferrer">{_("历史版本 ↗")}</a>
    <a class="text-link" href={route("/features#support-matrix")}>{_("平台支持矩阵 ↗")}</a>
  </div>
  <p class="download-note">{_("iOS 正在真机开发验证中，暂未公开分发。安装或连接遇到问题，可先查看")}<a class="text-link" href={route("/guide")}>{_("进阶指南")}</a>{_("。")}</p>
</section>
